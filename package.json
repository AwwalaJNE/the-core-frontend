{
  "name": "thecore",
  "version": "2.0.2",
  "author": "Odon",
  "contributors": [
    "Odon",
    "Bagus"
  ],
  "engines": {
    "node": "10.13.0"
  },
  "main": "server.js",
  "description": "Core",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lint": "stylelint '**/*.vue' '**/*.scss' --fix scss",
    "build:digitalocean": "npm install --production=false && npm run build && npm ci",
    "test": "cross-env NODE_NO_WARNINGS=1 jest"
  },
  "dependencies": {
    "@vue/eslint-config-airbnb": "^4.0.1",
    "@yaireo/tagify": "^3.21.4",
    "@zxing/library": "^0.20.0",
    "axios": "^0.21.1",
    "boxicons": "^2.0.5",
    "chart.js": "^2.9.4",
    "core-js": "^3.1.2",
    "element-ui": "^2.14.0",
    "http-proxy-middleware": "^2.0.6",
    "leaflet": "^1.7.1",
    "moment-timezone": "^0.5.32",
    "node-sass": "^4.13.0",
    "vee-validate": "^3.4.2",
    "vue": "^2.6.10",
    "vue-barcode": "^1.3.0",
    "vue-chartjs": "^3.5.1",
    "vue-clipboard2": "^0.3.1",
    "vue-currency-input": "^1.22.6",
    "vue-loading-skeleton": "^1.1.9",
    "vue-ls": "^3.2.1",
    "vue-moment": "^4.1.0",
    "vue-router": "^3.6.5",
    "vuesax": "^4.0.1-alpha.25",
    "vuex": "^3.0.1",
    "xlsx": "^0.16.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.3",
    "@vue/cli-plugin-babel": "^4.0.0",
    "@vue/cli-plugin-unit-jest": "^5.0.8",
    "@vue/cli-service": "^3.12.1",
    "@vue/test-utils": "^1.0.0-beta.29",
    "@vue/vue2-jest": "^29.2.6",
    "babel-eslint": "^10.0.3",
    "babel-jest": "^29.7.0",
    "babel-preset-airbnb": "^4.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^6.5.1",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-vue": "^5.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.1.1",
    "pug-plain-loader": "^1.0.0",
    "sass-loader": "^8.0.0",
    "stylelint-config-standard": "^18.3.0",
    "stylelint-processor-html": "^1.0.0",
    "vue-jest": "^3.0.7",
    "vue-template-compiler": "^2.6.10"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "jest": {
    "preset": "@vue/cli-plugin-unit-jest",
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(vee-validate)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/tests/unit/**/*.spec.[jt]s?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ]
  }
}
